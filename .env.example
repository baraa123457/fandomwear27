# Supabase — get these from Project Settings > API in your Supabase dashboard.
# Copy this file to .env.local and fill in real values (never commit .env.local).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by Postgres functions / admin operations that must
# bypass RLS (e.g. order creation, admin role checks). NEVER expose this
# with a NEXT_PUBLIC_ prefix or ship it to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
